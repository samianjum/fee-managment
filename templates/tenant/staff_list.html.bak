{% extends 'tenant/base.html' %}
{% load fee_extras %}
{% block title %}Staff Management | {{ tenant.name }}{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h1 class="page-title">Staff Management</h1>
        <p class="page-desc">Manage teachers, administrators, and support staff</p>
    </div>
    <div class="header-actions">
        <a href="{% url 'staff_add' schema_name=tenant.schema_name %}" class="btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 4v16m8-8H4"/></svg>
            Add Staff
        </a>
    </div>
</div>

<!-- KPIs -->
<div class="kpi-grid">
    <div class="kpi-card">
        <div class="kpi-icon blue"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg></div>
        <div class="kpi-info">
            <div class="kpi-label">Total Staff</div>
            <div class="kpi-value">{{ staff.paginator.count }}</div>
            <div class="kpi-sub">All staff</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon green"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg></div>
        <div class="kpi-info">
            <div class="kpi-label">Active</div>
            <div class="kpi-value">{{ total_active }}</div>
            <div class="kpi-sub">Currently working</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon orange"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M3 12h3l3-9 3 18 3-9h3"/></svg></div>
        <div class="kpi-info">
            <div class="kpi-label">Departments</div>
            <div class="kpi-value">{{ departments|length }}</div>
            <div class="kpi-sub">Unique</div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="filter-card">
    <form method="get" class="filter-form">
        <div class="filter-group">
            <input type="text" name="q" placeholder="Search name, ID, email..." value="{{ search_query }}" class="filter-input">
        </div>
        <div class="filter-group">
            <select name="department" class="filter-select">
                <option value="">All Departments</option>
                {% for dept in departments %}
                <option value="{{ dept }}" {% if request.GET.department == dept %}selected{% endif %}>{{ dept|title }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="filter-group">
            <select name="status" class="filter-select">
                <option value="">All Status</option>
                {% for k, v in status_choices %}
                <option value="{{ k }}" {% if request.GET.status == k %}selected{% endif %}>{{ v }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="filter-actions">
            <button type="submit" class="btn-filter">Apply</button>
            <a href="{% url 'staff_list' schema_name=tenant.schema_name %}" class="btn-reset">Reset</a>
        </div>
    </form>
</div>

<!-- Staff Table -->
<div class="table-card">
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Staff ID</th>
                    <th>Full Name</th>
                    <th>Job Title</th>
                    <th>Department</th>
                            <th>Email</th>
                            <th>Classes</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for s in staff %}
                <tr>
                    <td><span class="roll-badge">{{ s.staff_id }}</span></td>
                    <td><strong>{{ s.full_name }}</strong></td>
                    <td>{{ s.job_title|default:"—" }}</td>
                    <td>{{ s.get_department_display }}</td>
                            <td>{{ s.email|default:"—" }}</td>
                            <td>
                                {% if s.class_teacher_of.all %}
                                    <span class="badge badge-primary">Class Teacher: {{ s.class_teacher_of.first.name }}</span>
                                {% endif %}
                                {% if s.class_subjects.all %}
                                    <span class="badge badge-secondary">Subject Teacher: {{ s.class_subjects.all|join:", " }}</span>
                                {% endif %}
                            </td>
                    <td><span class="status-badge status-{{ s.status }}">{{ s.get_status_display }}</span></td>
                    <td class="action-btns">
                        <a href="{% url 'staff_profile' schema_name=tenant.schema_name staff_id=s.id %}" class="action-icon" title="Profile">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                        </a>
                        <a href="{% url 'staff_edit' schema_name=tenant.schema_name staff_id=s.id %}" class="action-icon" title="Edit">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 013 3L12 15l-4 1 1-4Z"/></svg>
                        </a>
                    </td>
                </tr>
                {% empty %}
                <tr><td colspan="7" class="empty-row">No staff members found. <a href="{% url 'staff_add' schema_name=tenant.schema_name %}" class="btn-sm">Add one</a></td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="pagination-bar">
        <div class="pagination-info">
            Showing {{ staff.start_index }} – {{ staff.end_index }} of {{ staff.paginator.count }}
        </div>
        <div class="pagination-links">
            {% if staff.has_previous %}
                <a href="?page=1{% if search_query %}&q={{ search_query }}{% endif %}{% if request.GET.department %}&department={{ request.GET.department }}{% endif %}{% if request.GET.status %}&status={{ request.GET.status }}{% endif %}" class="page-link">«</a>
                <a href="?page={{ staff.previous_page_number }}{% if search_query %}&q={{ search_query }}{% endif %}{% if request.GET.department %}&department={{ request.GET.department }}{% endif %}{% if request.GET.status %}&status={{ request.GET.status }}{% endif %}" class="page-link">‹</a>
            {% else %}
                <span class="page-link disabled">«</span>
                <span class="page-link disabled">‹</span>
            {% endif %}

            <span class="page-link active">{{ staff.number }}</span>

            {% if staff.has_next %}
                <a href="?page={{ staff.next_page_number }}{% if search_query %}&q={{ search_query }}{% endif %}{% if request.GET.department %}&department={{ request.GET.department }}{% endif %}{% if request.GET.status %}&status={{ request.GET.status }}{% endif %}" class="page-link">›</a>
                <a href="?page={{ staff.paginator.num_pages }}{% if search_query %}&q={{ search_query }}{% endif %}{% if request.GET.department %}&department={{ request.GET.department }}{% endif %}{% if request.GET.status %}&status={{ request.GET.status }}{% endif %}" class="page-link">»</a>
            {% else %}
                <span class="page-link disabled">›</span>
                <span class="page-link disabled">»</span>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
